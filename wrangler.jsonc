{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sangan",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "a6b7684e-8e99-4ed4-bf2c-3964bccb2ab9","database_name": "sangan" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "a133e0effc454b7fbd4b4b8abff0bab1" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
